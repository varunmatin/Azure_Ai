{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Power BI Organization Hierarchy — Deneb Visual. Fully responsive; all position math lives in the data pipeline to avoid signal/datum scoping issues in Deneb.",
  "width": 1200,
  "height": 700,
  "padding": 0,
  "background": "#EEF2F7",
  "autosize": "none",

  "signals": [
    {"name": "titleH",  "value": 50},
    {"name": "legendH", "value": 20},
    {"name": "hdrH",    "value": 22},
    {"name": "gapX",    "value": 10},
    {"name": "hMargin", "value": 6},
    {
      "name": "selectedID",
      "value": "",
      "on": [
        {
          "events": {"type": "click", "markname": "nodeHitArea"},
          "update": "datum.EmployeeID != selectedID ? datum.EmployeeID : ''"
        }
      ]
    },
    {"name": "panelW", "value": 240},
    {
      "name": "panelTarget",
      "update": "selectedID != '' ? width - panelW : width"
    },
    {
      "name": "panelX",
      "update": "panelTarget"
    },
    {
      "name": "selNode",
      "value": {},
      "on": [
        {
          "events": {"signal": "selectedID"},
          "update": "selectedID !== '' ? (length(data('selectedNode')) > 0 ? data('selectedNode')[0] : {}) : {}"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "dataset"
    },
    {
      "name": "tree",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.EmployeeID != null && datum.EmployeeID !== ''"
        },
        {
          "type": "stratify",
          "key": "EmployeeID",
          "parentKey": "ManagerID"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [1000, 1000],
          "separation": false,
          "as": ["rawX", "rawY", "depth", "children"]
        },

        {
          "type": "joinaggregate",
          "groupby": ["depth"],
          "ops": ["count"],
          "as": ["levelCount"]
        },
        {
          "type": "joinaggregate",
          "ops": ["max", "max"],
          "fields": ["levelCount", "depth"],
          "as": ["maxLevelCount", "maxDepth"]
        },

        {
          "type": "window",
          "sort": {"field": "rawX", "order": "ascending"},
          "groupby": ["depth"],
          "ops": ["lag"],
          "fields": ["rawX"],
          "as": ["prevRawX"]
        },
        {
          "type": "formula",
          "as": "rawXGap",
          "expr": "datum.prevRawX != null ? datum.rawX - datum.prevRawX : null"
        },
        {
          "type": "joinaggregate",
          "ops": ["min"],
          "fields": ["rawXGap"],
          "as": ["minRawXGap"]
        },

        {
          "type": "formula",
          "as": "nodeW",
          "expr": "datum.minRawXGap > 0 ? max(20, floor((datum.minRawXGap * (width - 2*hMargin) - gapX * 1000) / (1000 + datum.minRawXGap))) : max(20, floor((width - 2*hMargin) / max(datum.maxLevelCount, 1)))"
        },
        {
          "type": "formula",
          "as": "nodeH",
          "expr": "max(65, min(95, floor((height - titleH - legendH) / max(datum.maxDepth + 1, 1) - 20)))"
        },

        {
          "type": "formula",
          "as": "scaleX",
          "expr": "(width - 2*hMargin - datum.nodeW) / 1000"
        },
        {
          "type": "formula",
          "as": "scaleY",
          "expr": "(height - titleH - legendH - datum.nodeH) / 1000"
        },

        {
          "type": "formula",
          "as": "displayX",
          "expr": "datum.rawX * datum.scaleX + hMargin"
        },
        {
          "type": "formula",
          "as": "displayY",
          "expr": "datum.rawY * datum.scaleY + titleH"
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {"type": "treelinks"},
        {
          "type": "formula", "as": "sx",
          "expr": "datum.source.rawX * (width - 2*hMargin - datum.source.nodeW) / 1000 + hMargin + datum.source.nodeW / 2"
        },
        {
          "type": "formula", "as": "sy",
          "expr": "datum.source.rawY * (height - titleH - legendH - datum.source.nodeH) / 1000 + titleH + datum.source.nodeH"
        },
        {
          "type": "formula", "as": "tx",
          "expr": "datum.target.rawX * (width - 2*hMargin - datum.target.nodeW) / 1000 + hMargin + datum.target.nodeW / 2"
        },
        {
          "type": "formula", "as": "ty",
          "expr": "datum.target.rawY * (height - titleH - legendH - datum.target.nodeH) / 1000 + titleH"
        },
        {
          "type": "formula", "as": "fy",
          "expr": "(datum.sy + datum.ty) / 2"
        },
        {
          "type": "formula", "as": "path",
          "expr": "'M' + datum.sx + ',' + datum.sy + ' V' + datum.fy + ' H' + datum.tx + ' V' + datum.ty"
        }
      ]
    },
    {
      "name": "selectedNode",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.EmployeeID === selectedID"
        }
      ]
    }
  ],

  "marks": [

    {
      "type": "text",
      "encode": {
        "update": {
          "x":          {"signal": "width / 2"},
          "y":          {"value": 18},
          "text":       {"value": "Organization Hierarchy"},
          "align":      {"value": "center"},
          "fill":       {"value": "#1E3A5F"},
          "fontSize":   {"value": 20},
          "fontWeight": {"value": "bold"},
          "font":       {"value": "Segoe UI, sans-serif"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x":        {"signal": "width / 2"},
          "y":        {"value": 38},
          "text":     {"value": "Click a card to view details  •  Click again to close"},
          "align":    {"value": "center"},
          "fill":     {"value": "#64748B"},
          "fontSize": {"value": 10},
          "font":     {"value": "Segoe UI, sans-serif"}
        }
      }
    },

    {
      "type": "path",
      "from": {"data": "links"},
      "encode": {
        "update": {
          "path":          {"field": "path"},
          "stroke":        {"value": "#94A3B8"},
          "strokeWidth":   {"value": 1.5},
          "strokeOpacity": {"value": 0.75}
        }
      }
    },

    {
      "name": "nodeGroup",
      "type": "group",
      "from": {"data": "tree"},
      "encode": {
        "update": {
          "x":      {"field": "displayX"},
          "y":      {"field": "displayY"},
          "width":  {"field": "nodeW"},
          "height": {"field": "nodeH"},
          "cursor": {"value": "default"}
        }
      },
      "marks": [

        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x":    {"value": 2},
              "y":    {"value": 2},
              "rx":   {"value": 7},
              "fill": {"value": "#00000015"}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"signal": "parent.nodeH"}
            }
          }
        },

        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x":  {"value": 0},
              "y":  {"value": 0},
              "rx": {"value": 7}
            },
            "update": {
              "width":       {"signal": "parent.nodeW"},
              "height":      {"signal": "parent.nodeH"},
              "fill":        {"value": "#FFFFFF"},
              "stroke":      {"signal": "parent.EmployeeID == selectedID ? '#F97316' : '#CBD5E1'"},
              "strokeWidth": {"signal": "parent.EmployeeID == selectedID ? 2.5 : 1"}
            }
          }
        },

        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x":  {"value": 0},
              "y":  {"value": 0},
              "rx": {"value": 7}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"signal": "hdrH"},
              "fill":   {"signal": "parent.depth===0?'#1E3A5F':parent.depth===1?'#1D4ED8':parent.depth===2?'#0284C7':parent.depth===3?'#059669':'#7C3AED'"}
            }
          }
        },
        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x": {"value": 0},
              "y": {"value": 15}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"value": 7},
              "fill":   {"signal": "parent.depth===0?'#1E3A5F':parent.depth===1?'#1D4ED8':parent.depth===2?'#0284C7':parent.depth===3?'#059669':'#7C3AED'"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":          {"value": 6},
              "y":          {"signal": "hdrH - 4"},
              "text":       {"signal": "parent.depth===0?'▸ C-SUITE':parent.depth===1?'▸ VP / SVP':parent.depth===2?'▸ DIRECTOR':parent.depth===3?'▸ MANAGER':'▸ IC'"},
              "fill":       {"value": "#DBEAFE"},
              "fontSize":   {"value": 7},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":          {"value": 6},
              "y":          {"signal": "hdrH + 14"},
              "text":       {"signal": "parent.Name"},
              "fill":       {"value": "#0F172A"},
              "fontSize":   {"signal": "parent.nodeW < 130 ? 9 : 11"},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":        {"value": 6},
              "y":        {"signal": "hdrH + 28"},
              "text":     {"signal": "parent.Title"},
              "fill":     {"value": "#334155"},
              "fontSize": {"signal": "parent.nodeW < 130 ? 7 : 9"},
              "font":     {"value": "Segoe UI, sans-serif"},
              "limit":    {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "rule",
          "interactive": false,
          "encode": {
            "update": {
              "x":           {"value": 6},
              "x2":          {"signal": "parent.nodeW - 6"},
              "y":           {"signal": "hdrH + 38"},
              "stroke":      {"value": "#E2E8F0"},
              "strokeWidth": {"value": 0.75}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":         {"value": 6},
              "y":         {"signal": "hdrH + 52"},
              "text":      {"signal": "parent.Department"},
              "fill":      {"value": "#64748B"},
              "fontSize":  {"value": 8},
              "fontStyle": {"value": "italic"},
              "font":      {"value": "Segoe UI, sans-serif"},
              "limit":     {"signal": "parent.nodeW - 58"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":         {"signal": "parent.nodeW - 6"},
              "y":         {"signal": "hdrH + 52"},
              "text":      {"signal": "parent.Location"},
              "fill":      {"value": "#94A3B8"},
              "fontSize":  {"value": 8},
              "align":     {"value": "right"},
              "fontStyle": {"value": "italic"},
              "font":      {"value": "Segoe UI, sans-serif"},
              "limit":     {"value": 52}
            }
          }
        },

        {
          "name": "nodeHitArea",
          "type": "rect",
          "encode": {
            "update": {
              "x":       {"value": 0},
              "y":       {"value": 0},
              "width":   {"signal": "parent.nodeW"},
              "height":  {"signal": "parent.nodeH"},
              "fill":    {"value": "transparent"},
              "cursor":  {"value": "pointer"},
              "tooltip": {
                "signal": "{'Name': parent.Name, 'Title': parent.Title, 'Department': parent.Department, 'Location': parent.Location, 'Employee ID': parent.EmployeeID, 'Metric Field': parent['Metric Field'], 'Level': parent.depth + 1}"
              }
            }
          }
        }

      ]
    },

    {
      "type": "group",
      "encode": {
        "update": {
          "x":      {"value": 8},
          "y":      {"signal": "height - legendH + 4"},
          "width":  {"value": 500},
          "height": {"value": 14}
        }
      },
      "marks": [
        {"type":"rect","encode":{"enter":{"x":{"value":0},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#1E3A5F"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":13},"y":{"value":9},"text":{"value":"C-Suite"},"fill":{"value":"#1E3A5F"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":60},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#1D4ED8"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":73},"y":{"value":9},"text":{"value":"VP / SVP"},"fill":{"value":"#1D4ED8"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":128},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#0284C7"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":141},"y":{"value":9},"text":{"value":"Director"},"fill":{"value":"#0284C7"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":192},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#059669"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":205},"y":{"value":9},"text":{"value":"Manager"},"fill":{"value":"#059669"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":256},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#7C3AED"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":269},"y":{"value":9},"text":{"value":"Individual Contributor"},"fill":{"value":"#7C3AED"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}}
      ]
    },

    {
      "name": "detailPanel",
      "type": "group",
      "encode": {
        "update": {
          "x":      {"signal": "panelX"},
          "y":      {"value": 0},
          "width":  {"signal": "panelW"},
          "height": {"signal": "height"},
          "clip":   {"value": true}
        }
      },
      "marks": [

        {
          "type": "rect",
          "encode": {
            "update": {
              "x":           {"value": 0},
              "y":           {"value": 0},
              "width":       {"signal": "panelW"},
              "height":      {"signal": "height"},
              "fill":        {"value": "#F8FAFC"},
              "stroke":      {"value": "#CBD5E1"},
              "strokeWidth": {"value": 1},
              "cornerRadius": {"value": 0}
            }
          }
        },

        {
          "type": "rect",
          "encode": {
            "update": {
              "x":      {"value": 0},
              "y":      {"value": 0},
              "width":  {"signal": "panelW"},
              "height": {"value": 64},
              "fill":   {"signal": "selNode.depth===0?'#1E3A5F':selNode.depth===1?'#1D4ED8':selNode.depth===2?'#0284C7':selNode.depth===3?'#059669':selNode.depth===4?'#7C3AED':'#1E3A5F'"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":          {"value": 12},
              "y":          {"value": 16},
              "text":       {"signal": "selNode.depth===0?'▸ C-SUITE':selNode.depth===1?'▸ VP / SVP':selNode.depth===2?'▸ DIRECTOR':selNode.depth===3?'▸ MANAGER':selNode.depth===4?'▸ IC':'▸ EMPLOYEE'"},
              "fill":       {"value": "#DBEAFE"},
              "fontSize":   {"value": 8},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "panelW - 40"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":          {"signal": "panelW - 10"},
              "y":          {"value": 16},
              "text":       {"value": "✕"},
              "fill":       {"value": "#93C5FD"},
              "fontSize":   {"value": 11},
              "align":      {"value": "right"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "cursor":     {"value": "pointer"},
              "tooltip":    {"value": "Click node again to close"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":          {"value": 12},
              "y":          {"value": 34},
              "text":       {"signal": "selNode.Name || ''"},
              "fill":       {"value": "#FFFFFF"},
              "fontSize":   {"value": 13},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "panelW - 20"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 12},
              "y":        {"value": 52},
              "text":     {"signal": "selNode.Title || ''"},
              "fill":     {"value": "#BFDBFE"},
              "fontSize": {"value": 9},
              "font":     {"value": "Segoe UI, sans-serif"},
              "limit":    {"signal": "panelW - 20"}
            }
          }
        },

        {
          "type": "rule",
          "encode": {
            "update": {
              "x":           {"value": 12},
              "x2":          {"signal": "panelW - 12"},
              "y":           {"value": 76},
              "stroke":      {"value": "#E2E8F0"},
              "strokeWidth": {"value": 0.75}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 12},
              "y":        {"value": 94},
              "text":     {"value": "EMPLOYEE ID"},
              "fill":     {"value": "#94A3B8"},
              "fontSize": {"value": 8},
              "font":     {"value": "Segoe UI, sans-serif"},
              "fontWeight": {"value": "bold"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 12},
              "y":        {"value": 108},
              "text":     {"signal": "selNode.EmployeeID || ''"},
              "fill":     {"value": "#334155"},
              "fontSize": {"value": 11},
              "font":     {"value": "Segoe UI, sans-serif"},
              "fontWeight": {"value": "bold"},
              "limit":    {"signal": "panelW - 20"}
            }
          }
        },

        {
          "type": "rule",
          "encode": {
            "update": {
              "x":           {"value": 12},
              "x2":          {"signal": "panelW - 12"},
              "y":           {"value": 120},
              "stroke":      {"value": "#E2E8F0"},
              "strokeWidth": {"value": 0.75}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 12},
              "y":        {"value": 136},
              "text":     {"value": "DEPARTMENT"},
              "fill":     {"value": "#94A3B8"},
              "fontSize": {"value": 8},
              "font":     {"value": "Segoe UI, sans-serif"},
              "fontWeight": {"value": "bold"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 12},
              "y":        {"value": 150},
              "text":     {"signal": "selNode.Department || ''"},
              "fill":     {"value": "#334155"},
              "fontSize": {"value": 10},
              "font":     {"value": "Segoe UI, sans-serif"},
              "limit":    {"signal": "panelW - 20"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 12},
              "y":        {"value": 170},
              "text":     {"value": "LOCATION"},
              "fill":     {"value": "#94A3B8"},
              "fontSize": {"value": 8},
              "font":     {"value": "Segoe UI, sans-serif"},
              "fontWeight": {"value": "bold"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 12},
              "y":        {"value": 184},
              "text":     {"signal": "selNode.Location || ''"},
              "fill":     {"value": "#334155"},
              "fontSize": {"value": 10},
              "font":     {"value": "Segoe UI, sans-serif"},
              "limit":    {"signal": "panelW - 20"}
            }
          }
        },

        {
          "type": "rule",
          "encode": {
            "update": {
              "x":           {"value": 12},
              "x2":          {"signal": "panelW - 12"},
              "y":           {"value": 198},
              "stroke":      {"value": "#CBD5E1"},
              "strokeWidth": {"value": 1}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":          {"value": 12},
              "y":          {"value": 214},
              "text":       {"value": "METRIC FIELD"},
              "fill":       {"value": "#64748B"},
              "fontSize":   {"value": 9},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"}
            }
          }
        },

        {
          "type": "rect",
          "encode": {
            "update": {
              "x":           {"value": 12},
              "y":           {"value": 222},
              "width":       {"signal": "panelW - 24"},
              "height":      {"value": 52},
              "rx":          {"value": 6},
              "fill":        {"signal": "selNode.depth===0?'#1E3A5F':selNode.depth===1?'#EFF6FF':selNode.depth===2?'#F0F9FF':selNode.depth===3?'#ECFDF5':selNode.depth===4?'#F5F3FF':'#EFF6FF'"},
              "stroke":      {"signal": "selNode.depth===0?'#1E3A5F':selNode.depth===1?'#BFDBFE':selNode.depth===2?'#BAE6FD':selNode.depth===3?'#A7F3D0':selNode.depth===4?'#DDD6FE':'#BFDBFE'"},
              "strokeWidth": {"value": 1}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":          {"signal": "panelW / 2"},
              "y":          {"value": 258},
              "text":       {"signal": "selNode['Metric Field'] != null && selNode['Metric Field'] !== '' ? '' + selNode['Metric Field'] : '—'"},
              "fill":       {"signal": "selNode.depth===0?'#FFFFFF':selNode.depth===1?'#1D4ED8':selNode.depth===2?'#0284C7':selNode.depth===3?'#059669':selNode.depth===4?'#7C3AED':'#1D4ED8'"},
              "fontSize":   {"value": 28},
              "fontWeight": {"value": "bold"},
              "align":      {"value": "center"},
              "baseline":   {"value": "alphabetic"},
              "font":       {"value": "Segoe UI, sans-serif"}
