{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Power BI Organization Hierarchy — Deneb Visual. Collapsible/expandable tree via treeClickStorePerm pattern. Click the +/− button on any node to toggle its subtree.",
  "width": 1200,
  "height": 700,
  "padding": 0,
  "background": "#FFFFFF",
  "autosize": "none",

  "signals": [
    {"name": "titleH",   "value": 10},
    {"name": "legendH",  "value": 36},
    {"name": "legendGap","value": 50},
    {"name": "hdrH",     "value": 22},
    {"name": "gapX",     "value": 10},
    {"name": "hMargin",  "value": 6},

    {
      "name": "pbiCrossFilterApply",
      "on": [
        {
          "events": {"type": "click", "markname": "nodeHitArea"},
          "update": "true",
          "force": true
        }
      ]
    },
    {
      "name": "pbiCrossFilterClear",
      "on": [
        {
          "events": "view:mousedown[!event.item]",
          "update": "true",
          "force": true
        }
      ]
    },
    {
      "name": "treeWidth",
      "update": "width"
    },

    {
      "name": "startingDepth",
      "value": 99,
      "on": [{"events": {"type": "timer", "throttle": 0}, "update": "-1"}]
    },

    {
      "name": "down",
      "value": null,
      "on": [
        {"events": "mousedown,touchstart", "update": "xy()"}
      ]
    },

    {
      "name": "isExpanded",
      "value": false,
      "on": [
        {
          "events": {"type": "click", "markname": "collapseBtn"},
          "update": "datum.totalChildren > 0 && datum.childrenIds && indata('treeClickStorePerm', 'EmployeeID', datum.childrenIds[0]) ? true : false"
        }
      ]
    },

    {
      "name": "node",
      "value": 0,
      "on": [
        {
          "events": {"type": "click", "markname": "collapseBtn"},
          "update": "xy()[0]==down[0] && xy()[1]==down[1] ? datum.EmployeeID : 0"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "dataset"
    },

    {
      "name": "treeCalcs",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.EmployeeID != null && datum.EmployeeID !== ''"
        },
        {
          "type": "stratify",
          "key": "EmployeeID",
          "parentKey": "ManagerID"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [1000, 1000],
          "separation": false,
          "as": ["rawX", "rawY", "depth", "children"]
        },
        {
          "type": "formula",
          "as": "ManagerID",
          "expr": "datum.ManagerID"
        }
      ]
    },

    {
      "name": "treeChildren",
      "source": "treeCalcs",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["ManagerID"],
          "fields": ["ManagerID"],
          "ops": ["values"],
          "as": ["childrenObjects"]
        },
        {
          "type": "formula",
          "expr": "pluck(datum.childrenObjects, 'EmployeeID')",
          "as": "childrenIds"
        }
      ]
    },

    {
      "name": "treeAncestors",
      "source": "treeCalcs",
      "transform": [
        {
          "type": "formula",
          "as": "ancestors",
          "expr": "treeAncestors('treeCalcs', datum.EmployeeID)"
        },
        {
          "type": "flatten",
          "fields": ["ancestors"]
        },
        {
          "type": "formula",
          "expr": "datum.ancestors.ManagerID",
          "as": "allParents"
        }
      ]
    },

    {
      "name": "treeClickStoreTemp",
      "source": "treeAncestors",
      "transform": [
        {
          "type": "filter",
          "expr": "startingDepth != -1 ? datum.depth <= startingDepth : node != 0 && !isExpanded ? datum.ManagerID == node : node != 0 && isExpanded ? datum.allParents == node : false"
        },
        {
          "type": "aggregate",
          "groupby": ["EmployeeID", "ManagerID", "depth"]
        }
      ]
    },

    {
      "name": "treeClickStorePerm",
      "values": [],
      "on": [
        {"trigger": "startingDepth >= 0", "insert": "data('treeClickStoreTemp')"},
        {"trigger": "node && !isExpanded",  "insert": "data('treeClickStoreTemp')"},
        {"trigger": "node && isExpanded",   "remove": "data('treeClickStoreTemp')"}
      ]
    },

    {
      "name": "tree",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.EmployeeID != null && datum.EmployeeID !== ''"
        },
        {
          "type": "filter",
          "expr": "indata('treeClickStorePerm', 'EmployeeID', datum.EmployeeID)"
        },
        {
          "type": "stratify",
          "key": "EmployeeID",
          "parentKey": "ManagerID"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [1000, 1000],
          "separation": false,
          "as": ["rawX", "rawY", "depth", "children"]
        },

        {
          "type": "lookup",
          "from": "treeChildren",
          "key": "ManagerID",
          "fields": ["EmployeeID"],
          "values": ["childrenIds"],
          "as": ["childrenIds"]
        },
        {
          "type": "lookup",
          "from": "treeCalcs",
          "key": "EmployeeID",
          "fields": ["EmployeeID"],
          "values": ["children"],
          "as": ["totalChildren"]
        },

        {
          "type": "joinaggregate",
          "groupby": ["depth"],
          "ops": ["count"],
          "as": ["levelCount"]
        },
        {
          "type": "joinaggregate",
          "ops": ["max", "max"],
          "fields": ["levelCount", "depth"],
          "as": ["maxLevelCount", "maxDepth"]
        },

        {
          "type": "window",
          "sort": {"field": "rawX", "order": "ascending"},
          "groupby": ["depth"],
          "ops": ["lag"],
          "fields": ["rawX"],
          "as": ["prevRawX"]
        },
        {
          "type": "formula",
          "as": "rawXGap",
          "expr": "datum.prevRawX != null ? datum.rawX - datum.prevRawX : null"
        },
        {
          "type": "joinaggregate",
          "ops": ["min"],
          "fields": ["rawXGap"],
          "as": ["minRawXGap"]
        },

        {
          "type": "formula",
          "as": "nodeW",
          "expr": "datum.minRawXGap > 0 ? max(20, floor((datum.minRawXGap * (treeWidth - 2*hMargin) - gapX * 1000) / (1000 + datum.minRawXGap))) : max(20, floor((treeWidth - 2*hMargin) / max(datum.maxLevelCount, 1)))"
        },
        {
          "type": "formula",
          "as": "nodeH",
          "expr": "max(65, min(95, floor((height - titleH - legendH - legendGap) / max(datum.maxDepth + 1, 1) - 20)))"
        },

        {
          "type": "formula",
          "as": "scaleX",
          "expr": "(treeWidth - 2*hMargin - datum.nodeW) / 1000"
        },
        {
          "type": "formula",
          "as": "scaleY",
          "expr": "(height - titleH - legendH - legendGap - datum.nodeH) / 1000"
        },

        {
          "type": "formula",
          "as": "displayX",
          "expr": "datum.rawX * datum.scaleX + hMargin"
        },
        {
          "type": "formula",
          "as": "displayY",
          "expr": "datum.rawY * datum.scaleY + titleH"
        }
      ]
    },

    {
      "name": "links",
      "source": "tree",
      "transform": [
        {"type": "treelinks"},
        {
          "type": "formula", "as": "sx",
          "expr": "datum.source.rawX * (treeWidth - 2*hMargin - datum.source.nodeW) / 1000 + hMargin + datum.source.nodeW / 2"
        },
        {
          "type": "formula", "as": "sy",
          "expr": "datum.source.rawY * (height - titleH - legendH - legendGap - datum.source.nodeH) / 1000 + titleH + datum.source.nodeH"
        },
        {
          "type": "formula", "as": "tx",
          "expr": "datum.target.rawX * (treeWidth - 2*hMargin - datum.target.nodeW) / 1000 + hMargin + datum.target.nodeW / 2"
        },
        {
          "type": "formula", "as": "ty",
          "expr": "datum.target.rawY * (height - titleH - legendH - legendGap - datum.target.nodeH) / 1000 + titleH"
        },
        {
          "type": "formula", "as": "fy",
          "expr": "(datum.sy + datum.ty) / 2"
        },
        {
          "type": "formula", "as": "path",
          "expr": "'M' + datum.sx + ',' + datum.sy + ' V' + datum.fy + ' H' + datum.tx + ' V' + datum.ty"
        }
      ]
    }
  ],

  "marks": [

    {
      "type": "path",
      "from": {"data": "links"},
      "encode": {
        "update": {
          "path":          {"field": "path"},
          "stroke":        {"value": "#94A3B8"},
          "strokeWidth":   {"value": 1.5},
          "strokeOpacity": {"value": 0.75}
        }
      }
    },

    {
      "name": "nodeGroup",
      "type": "group",
      "from": {"data": "tree"},
      "encode": {
        "update": {
          "x":      {"field": "displayX"},
          "y":      {"field": "displayY"},
          "width":  {"field": "nodeW"},
          "height": {"field": "nodeH"},
          "cursor": {"value": "default"}
        }
      },
      "marks": [

        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x":    {"value": 2},
              "y":    {"value": 2},
              "rx":   {"value": 7},
              "fill": {"value": "#00000015"}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"signal": "parent.nodeH"}
            }
          }
        },

        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x":  {"value": 0},
              "y":  {"value": 0},
              "rx": {"value": 7}
            },
            "update": {
              "width":       {"signal": "parent.nodeW"},
              "height":      {"signal": "parent.nodeH"},
              "fill":        {"value": "#FFFFFF"},
              "stroke":      {"signal": "parent.__selected__ == 'on' ? '#F97316' : '#CBD5E1'"},
              "strokeWidth": {"signal": "parent.__selected__ == 'on' ? 2.5 : 1"}
            }
          }
        },

        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x":  {"value": 0},
              "y":  {"value": 0},
              "rx": {"value": 7}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"signal": "hdrH"},
              "fill":   {"signal": "parent.depth===0?'#1E3A5F':parent.depth===1?'#1D4ED8':parent.depth===2?'#0284C7':parent.depth===3?'#059669':'#7C3AED'"}
            }
          }
        },
        {
          "type": "rect",
          "interactive": false,
          "encode": {
            "enter": {
              "x": {"value": 0},
              "y": {"value": 15}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"value": 7},
              "fill":   {"signal": "parent.depth===0?'#1E3A5F':parent.depth===1?'#1D4ED8':parent.depth===2?'#0284C7':parent.depth===3?'#059669':'#7C3AED'"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":          {"value": 6},
              "y":          {"signal": "hdrH - 4"},
              "text":       {"signal": "parent.depth===0?'▸ C-SUITE':parent.depth===1?'▸ VP / SVP':parent.depth===2?'▸ DIRECTOR':parent.depth===3?'▸ MANAGER':'▸ IC'"},
              "fill":       {"value": "#DBEAFE"},
              "fontSize":   {"value": 7},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":          {"value": 6},
              "y":          {"signal": "hdrH + 14"},
              "text":       {"signal": "parent.Name"},
              "fill":       {"value": "#0F172A"},
              "fontSize":   {"signal": "parent.nodeW < 130 ? 9 : 11"},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":        {"value": 6},
              "y":        {"signal": "hdrH + 28"},
              "text":     {"signal": "parent.Title"},
              "fill":     {"value": "#334155"},
              "fontSize": {"signal": "parent.nodeW < 130 ? 7 : 9"},
              "font":     {"value": "Segoe UI, sans-serif"},
              "limit":    {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "rule",
          "interactive": false,
          "encode": {
            "update": {
              "x":           {"value": 6},
              "x2":          {"signal": "parent.nodeW - 6"},
              "y":           {"signal": "hdrH + 38"},
              "stroke":      {"value": "#E2E8F0"},
              "strokeWidth": {"value": 0.75}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":         {"value": 6},
              "y":         {"signal": "hdrH + 52"},
              "text":      {"signal": "parent.Department"},
              "fill":      {"value": "#64748B"},
              "fontSize":  {"value": 8},
              "fontStyle": {"value": "italic"},
              "font":      {"value": "Segoe UI, sans-serif"},
              "limit":     {"signal": "parent.nodeW - 58"}
            }
          }
        },

        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x":         {"signal": "parent.nodeW - 6"},
              "y":         {"signal": "hdrH + 52"},
              "text":      {"signal": "parent.Location"},
              "fill":      {"value": "#94A3B8"},
              "fontSize":  {"value": 8},
              "align":     {"value": "right"},
              "fontStyle": {"value": "italic"},
              "font":      {"value": "Segoe UI, sans-serif"},
              "limit":     {"value": 52}
            }
          }
        }

      ]
    },

    {
      "name": "nodeHitArea",
      "type": "rect",
      "from": {"data": "tree"},
      "encode": {
        "update": {
          "x":      {"field": "displayX"},
          "y":      {"field": "displayY"},
          "width":  {"field": "nodeW"},
          "height": {"field": "nodeH"},
          "fill":   {"value": "transparent"},
          "cursor": {"value": "pointer"},
          "tooltip": {
            "signal": "{'Name': datum.Name, 'Title': datum.Title, 'Department': datum.Department, 'Location': datum.Location, 'Employee ID': datum.EmployeeID, 'Metric Field': datum['Metric Field'], 'Level': datum.depth + 1}"
          }
        }
      }
    },

    {
      "name": "collapseBtn",
      "type": "rect",
      "from": {"data": "tree"},
      "encode": {
        "update": {
          "x":            {"signal": "datum.displayX + datum.nodeW / 2 - 8"},
          "y":            {"signal": "datum.displayY + datum.nodeH - 8"},
          "width":        {"value": 16},
          "height":       {"value": 16},
          "cornerRadius": {"value": 8},
          "fill":         {"signal": "datum.totalChildren > 0 && datum.childrenIds && indata('treeClickStorePerm', 'EmployeeID', datum.childrenIds[0]) ? '#1D4ED8' : '#94A3B8'"},
          "stroke":       {"value": "#FFFFFF"},
          "strokeWidth":  {"value": 1.5},
          "cursor":       {"value": "pointer"},
          "opacity":      {"signal": "datum.totalChildren > 0 ? 1 : 0"},
          "tooltip":      {"signal": "datum.totalChildren > 0 && datum.childrenIds && indata('treeClickStorePerm', 'EmployeeID', datum.childrenIds[0]) ? 'Click to collapse' : 'Click to expand'"}
        }
      }
    },

    {
      "type": "text",
      "from": {"data": "tree"},
      "interactive": false,
      "encode": {
        "update": {
          "x":          {"signal": "datum.displayX + datum.nodeW / 2"},
          "y":          {"signal": "datum.displayY + datum.nodeH"},
          "text":       {"signal": "datum.totalChildren > 0 && datum.childrenIds && indata('treeClickStorePerm', 'EmployeeID', datum.childrenIds[0]) ? '\u2212' : '+'"},
          "align":      {"value": "center"},
          "baseline":   {"value": "middle"},
          "fill":       {"value": "#FFFFFF"},
          "fontSize":   {"value": 11},
          "fontWeight": {"value": "bold"},
          "font":       {"value": "Segoe UI, sans-serif"},
          "opacity":    {"signal": "datum.totalChildren > 0 ? 1 : 0"}
        }
      }
    },

    {
      "type": "group",
      "encode": {
        "update": {
          "x":      {"signal": "max(8, (width - 400) / 2)"},
          "y":      {"signal": "height - legendH"},
          "width":  {"value": 500},
          "height": {"value": 14}
        }
      },
      "marks": [
        {"type":"rect","encode":{"enter":{"x":{"value":0},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#1E3A5F"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":13},"y":{"value":9},"text":{"value":"C-Suite"},"fill":{"value":"#1E3A5F"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":60},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#1D4ED8"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":73},"y":{"value":9},"text":{"value":"VP / SVP"},"fill":{"value":"#1D4ED8"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":128},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#0284C7"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":141},"y":{"value":9},"text":{"value":"Director"},"fill":{"value":"#0284C7"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":192},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#059669"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":205},"y":{"value":9},"text":{"value":"Manager"},"fill":{"value":"#059669"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":256},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#7C3AED"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":269},"y":{"value":9},"text":{"value":"Individual Contributor"},"fill":{"value":"#7C3AED"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}}
      ]
    }

  ]
}
