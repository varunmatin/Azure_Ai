{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Power BI Organization Hierarchy — Deneb Visual. Fully responsive; all position math lives in the data pipeline to avoid signal/datum scoping issues in Deneb.",
  "width": 1200,
  "height": 700,
  "padding": {"left": 8, "right": 8, "top": 8, "bottom": 8},
  "background": "#EEF2F7",
  "autosize": {"type": "fit", "contains": "padding"},

  "signals": [
    {"name": "titleH",  "value": 50},
    {"name": "legendH", "value": 20},
    {"name": "hdrH",    "value": 22},
    {"name": "gapX",    "value": 10},
    {
      "name": "selectedID",
      "value": "",
      "on": [
        {
          "events": "@nodeGroup:click",
          "update": "datum.EmployeeID != selectedID ? datum.EmployeeID : ''"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "dataset"
    },
    {
      "name": "tree",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.EmployeeID != null && datum.EmployeeID !== ''"
        },
        {
          "type": "stratify",
          "key": "EmployeeID",
          "parentKey": "ManagerID"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [1000, 1000],
          "separation": false,
          "as": ["rawX", "rawY", "depth", "children"]
        },

        {
          "type": "joinaggregate",
          "groupby": ["depth"],
          "ops": ["count"],
          "as": ["levelCount"]
        },
        {
          "type": "joinaggregate",
          "ops": ["max", "max"],
          "fields": ["levelCount", "depth"],
          "as": ["maxLevelCount", "maxDepth"]
        },

        {
          "type": "formula",
          "as": "nodeW",
          "expr": "max(100, floor((width - (datum.maxLevelCount - 1) * gapX) / datum.maxLevelCount))"
        },
        {
          "type": "formula",
          "as": "nodeH",
          "expr": "max(65, min(95, floor((height - titleH - legendH) / max(datum.maxDepth + 1, 1) - 20)))"
        },

        {
          "type": "formula",
          "as": "scaleX",
          "expr": "(width - datum.nodeW) / 1000"
        },
        {
          "type": "formula",
          "as": "scaleY",
          "expr": "(height - titleH - legendH - datum.nodeH) / 1000"
        },

        {
          "type": "formula",
          "as": "displayX",
          "expr": "datum.rawX * datum.scaleX"
        },
        {
          "type": "formula",
          "as": "displayY",
          "expr": "datum.rawY * datum.scaleY + titleH"
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {"type": "treelinks"},
        {
          "type": "formula", "as": "sx",
          "expr": "datum.source.displayX + datum.source.nodeW / 2"
        },
        {
          "type": "formula", "as": "sy",
          "expr": "datum.source.displayY + datum.source.nodeH"
        },
        {
          "type": "formula", "as": "tx",
          "expr": "datum.target.displayX + datum.target.nodeW / 2"
        },
        {
          "type": "formula", "as": "ty",
          "expr": "datum.target.displayY"
        },
        {
          "type": "linkpath",
          "orient": "vertical",
          "shape": "orthogonal",
          "sourceX": "sx",
          "sourceY": "sy",
          "targetX": "tx",
          "targetY": "ty"
        }
      ]
    }
  ],

  "marks": [

    {
      "type": "text",
      "encode": {
        "update": {
          "x":          {"signal": "width / 2"},
          "y":          {"value": 18},
          "text":       {"value": "Organization Hierarchy"},
          "align":      {"value": "center"},
          "fill":       {"value": "#1E3A5F"},
          "fontSize":   {"value": 20},
          "fontWeight": {"value": "bold"},
          "font":       {"value": "Segoe UI, sans-serif"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x":        {"signal": "width / 2"},
          "y":        {"value": 38},
          "text":     {"value": "Click a card to highlight  •  Hover for full details"},
          "align":    {"value": "center"},
          "fill":     {"value": "#64748B"},
          "fontSize": {"value": 10},
          "font":     {"value": "Segoe UI, sans-serif"}
        }
      }
    },

    {
      "type": "path",
      "from": {"data": "links"},
      "encode": {
        "update": {
          "path":          {"field": "path"},
          "stroke":        {"value": "#94A3B8"},
          "strokeWidth":   {"value": 1.5},
          "strokeOpacity": {"value": 0.75}
        }
      }
    },

    {
      "name": "nodeGroup",
      "type": "group",
      "from": {"data": "tree"},
      "encode": {
        "update": {
          "x":      {"field": "displayX"},
          "y":      {"field": "displayY"},
          "width":  {"field": "nodeW"},
          "height": {"field": "nodeH"},
          "cursor": {"value": "pointer"},
          "tooltip": {
            "signal": "{'Name': datum.Name, 'Title': datum.Title, 'Department': datum.Department, 'Location': datum.Location, 'Employee ID': datum.EmployeeID, 'Level': datum.depth + 1}"
          }
        }
      },
      "marks": [

        {
          "type": "rect",
          "encode": {
            "enter": {
              "x":    {"value": 2},
              "y":    {"value": 2},
              "rx":   {"value": 7},
              "fill": {"value": "#00000015"}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"signal": "parent.nodeH"}
            }
          }
        },

        {
          "type": "rect",
          "encode": {
            "enter": {
              "x":  {"value": 0},
              "y":  {"value": 0},
              "rx": {"value": 7}
            },
            "update": {
              "width":       {"signal": "parent.nodeW"},
              "height":      {"signal": "parent.nodeH"},
              "fill":        {"value": "#FFFFFF"},
              "stroke":      {"signal": "parent.EmployeeID == selectedID ? '#F97316' : '#CBD5E1'"},
              "strokeWidth": {"signal": "parent.EmployeeID == selectedID ? 2.5 : 1"}
            },
            "hover": {
              "stroke":      {"value": "#3B82F6"},
              "strokeWidth": {"value": 2}
            }
          }
        },

        {
          "type": "rect",
          "encode": {
            "enter": {
              "x":  {"value": 0},
              "y":  {"value": 0},
              "rx": {"value": 7}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"signal": "hdrH"},
              "fill":   {"signal": "parent.depth===0?'#1E3A5F':parent.depth===1?'#1D4ED8':parent.depth===2?'#0284C7':parent.depth===3?'#059669':'#7C3AED'"}
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "enter": {
              "x": {"value": 0},
              "y": {"value": 15}
            },
            "update": {
              "width":  {"signal": "parent.nodeW"},
              "height": {"value": 7},
              "fill":   {"signal": "parent.depth===0?'#1E3A5F':parent.depth===1?'#1D4ED8':parent.depth===2?'#0284C7':parent.depth===3?'#059669':'#7C3AED'"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":          {"value": 6},
              "y":          {"signal": "hdrH - 4"},
              "text":       {"signal": "parent.depth===0?'▸ C-SUITE':parent.depth===1?'▸ VP / SVP':parent.depth===2?'▸ DIRECTOR':parent.depth===3?'▸ MANAGER':'▸ IC'"},
              "fill":       {"value": "#DBEAFE"},
              "fontSize":   {"value": 7},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":          {"value": 6},
              "y":          {"signal": "hdrH + 14"},
              "text":       {"signal": "parent.Name"},
              "fill":       {"value": "#0F172A"},
              "fontSize":   {"signal": "parent.nodeW < 130 ? 9 : 11"},
              "fontWeight": {"value": "bold"},
              "font":       {"value": "Segoe UI, sans-serif"},
              "limit":      {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":        {"value": 6},
              "y":        {"signal": "hdrH + 28"},
              "text":     {"signal": "parent.Title"},
              "fill":     {"value": "#334155"},
              "fontSize": {"signal": "parent.nodeW < 130 ? 7 : 9"},
              "font":     {"value": "Segoe UI, sans-serif"},
              "limit":    {"signal": "parent.nodeW - 10"}
            }
          }
        },

        {
          "type": "rule",
          "encode": {
            "update": {
              "x":           {"value": 6},
              "x2":          {"signal": "parent.nodeW - 6"},
              "y":           {"signal": "hdrH + 38"},
              "stroke":      {"value": "#E2E8F0"},
              "strokeWidth": {"value": 0.75}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":         {"value": 6},
              "y":         {"signal": "hdrH + 52"},
              "text":      {"signal": "parent.Department"},
              "fill":      {"value": "#64748B"},
              "fontSize":  {"value": 8},
              "fontStyle": {"value": "italic"},
              "font":      {"value": "Segoe UI, sans-serif"},
              "limit":     {"signal": "parent.nodeW - 58"}
            }
          }
        },

        {
          "type": "text",
          "encode": {
            "update": {
              "x":         {"signal": "parent.nodeW - 6"},
              "y":         {"signal": "hdrH + 52"},
              "text":      {"signal": "parent.Location"},
              "fill":      {"value": "#94A3B8"},
              "fontSize":  {"value": 8},
              "align":     {"value": "right"},
              "fontStyle": {"value": "italic"},
              "font":      {"value": "Segoe UI, sans-serif"},
              "limit":     {"value": 52}
            }
          }
        }

      ]
    },

    {
      "type": "group",
      "encode": {
        "update": {
          "x":      {"value": 8},
          "y":      {"signal": "height - legendH + 4"},
          "width":  {"value": 500},
          "height": {"value": 14}
        }
      },
      "marks": [
        {"type":"rect","encode":{"enter":{"x":{"value":0},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#1E3A5F"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":13},"y":{"value":9},"text":{"value":"C-Suite"},"fill":{"value":"#1E3A5F"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":60},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#1D4ED8"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":73},"y":{"value":9},"text":{"value":"VP / SVP"},"fill":{"value":"#1D4ED8"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":128},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#0284C7"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":141},"y":{"value":9},"text":{"value":"Director"},"fill":{"value":"#0284C7"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":192},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#059669"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":205},"y":{"value":9},"text":{"value":"Manager"},"fill":{"value":"#059669"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}},
        {"type":"rect","encode":{"enter":{"x":{"value":256},"y":{"value":0},"width":{"value":10},"height":{"value":10},"rx":{"value":2},"fill":{"value":"#7C3AED"}}}},
        {"type":"text","encode":{"enter":{"x":{"value":269},"y":{"value":9},"text":{"value":"Individual Contributor"},"fill":{"value":"#7C3AED"},"fontSize":{"value":8},"fontWeight":{"value":"bold"},"font":{"value":"Segoe UI, sans-serif"}}}}
      ]
    }

  ]
}
